{
    "name": "@packages/database",
    "version": "1.0.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "db:prepare-schema": "node prisma/build-runtime-schema.cjs",
        "db:generate": "pnpm db:prepare-schema && npx prisma generate --schema=./prisma/schema.runtime.prisma",
        "db:push": "pnpm db:prepare-schema && npx prisma db push --schema=./prisma/schema.runtime.prisma",
        "db:migrate": "pnpm db:prepare-schema && npx prisma migrate dev --schema=./prisma/schema.runtime.prisma",
        "db:migrate:deploy": "pnpm db:prepare-schema && npx prisma migrate deploy --schema=./prisma/schema.runtime.prisma",
        "db:studio": "pnpm db:prepare-schema && npx prisma studio --schema=./prisma/schema.runtime.prisma",
        "db:seed": "npx tsx prisma/seed.ts",
        "db:reset": "pnpm db:prepare-schema && npx prisma migrate reset --schema=./prisma/schema.runtime.prisma --force",
        "db:fresh": "pnpm db:reset && pnpm db:seed",
        "build": "pnpm db:generate && npx tsc",
        "test": "echo 'No tests yet'"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^3.0.3"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "^20.10.0",
        "esbuild": "^0.27.2",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.6.2",
        "typescript": "^5.3.2"
    }
}
